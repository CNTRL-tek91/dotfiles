#
# DISABLED deliberately. ckb-next is a Corsair RGB driver, and this laptop's
# Legion keyboard controller reports itself over USB as
# "Corsair Gaming K95 RGB PLATINUM Keyboard" (048d:c935, actually an ITE part).
# ckb-next will therefore claim it - and OpenRGB already drives it. Two
# programs writing the same controller is what makes the lighting glitch.
#
# Hidden=true is the XDG spec's way to disable an autostart entry, which is
# preferred over deleting the file: ckb-next wrote this itself, and the entry
# staying visible-but-off records the decision instead of looking like it was
# never set up.
#
# This is currently dormant for a second reason - xdg-desktop-autostart.target
# is inactive on this machine, so nothing processes ~/.config/autostart at all.
# That is luck, not design: enabling XDG autostart later would have started
# ckb-next alongside OpenRGB. Hidden=true removes that trap.
#
# OpenRGB.desktop in this same directory has the identical problem and is NOT
# tracked here, because OpenRGB rewrites it on every launch (its own AutoStart
# setting). Turn that off inside OpenRGB's settings rather than fighting the
# file.
[Desktop Entry]
Version=1.0
Type=Application
Name=ckb-next
Comment=Corsair keyboard driver user interface
Keywords=ckb;corsair;keyboard;rgb;
Categories=Settings;System;
TryExec=/usr/bin/ckb-next
Exec=/usr/bin/ckb-next --background
Icon=ckb-next
StartupNotify=true
Hidden=true
