# Generated by wallust/pywal on every wallpaper change — machine-local output,
# not configuration. Tracking these guarantees conflicts between machines.
.config/kitty/wallust-colors.conf
.config/nvim-custom/lua/wallust_base16.lua
# lushwal compiles a colorscheme from pywal's cache into the *config*
# directory - the path is hardcoded to $XDG_CONFIG_HOME/nvim/colors, which
# stow points straight back into this repo. Same class of file as the two
# above: wallpaper-derived, regenerated on every wallpaper change.
.config/nvim/colors/

# Python bytecode, if a script here is ever imported rather than executed
__pycache__/
